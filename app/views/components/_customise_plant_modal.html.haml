#customisePlantModal.modal.fade{ tabindex: -1,
aria: { labelledby: 'customisePlantModalLabel', hidden: true } }
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        %h1#customisePlantModalLabel.modal-title.fs-5
          Customise Plant
        %button.btn-close{ type: 'button', data: { bs_dismiss: 'modal' },
        aria: { label: 'Close' } }
      #customise-plant-modal-body.modal-body
        = render 'subscriber/plants/form', plant: plant,
        user_plant_items: user_plant_items, user_pot_items: user_pot_items
      .modal-footer
        %button.btn.btn-secondary{ type: 'button', data: { bs_dismiss: 'modal' } }
          Close
