.col-md-6.col-lg-3
  .card.feature-card.h-100.text-center.p-3
    %div.fs-1.mb-2
      %i{ class: icon_class }
    %h3.h5.mb-2= title
    %p.mb-2= description
    = render('components/modal_expand_button',
      bs_target: bs_target,
      bs_name: title,
      bs_message: bs_message,
      bs_image: bs_image,
      bs_event_view_name: bs_event_view_name)