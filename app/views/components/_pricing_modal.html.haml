.modal.fade#pricingModal{
  tabindex: '-1',
  aria: { labelledby: 'pricingModalLabel', hidden: 'true' }
}
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        .modal-title.fs-5#pricingModalLabel
        %button.btn-close{
          type: 'button',
          data: { bs_dismiss: 'modal' },
          aria: { label: 'Close' }
        }
      .modal-body