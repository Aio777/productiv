.row.justify-content-center
  .col-sm-8.col-lg-6
    .card
      .card-header
        Admin User Details

      .card-body
        %dl.row.mb-0
          %dt.col-md-3 Name
          %dd.col-md-9= "#{@user.first_name} #{@user.last_name}"

          %dt.col-md-3 Email
          %dd.col-md-9= @user.email

          %dt.col-md-3 Role
          %dd.col-md-9
            - if @user.role == "signee"
              Deactivated
            - else
              = @user.role.capitalize

      .card-footer.d-flex
        = link_to 'Edit', edit_admin_user_path(@user), class: 'btn btn-link'
        = link_to 'Back', admin_users_path, class: 'btn btn-link ms-auto'
