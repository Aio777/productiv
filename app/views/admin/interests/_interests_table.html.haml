= turbo_frame_tag 'interests_table' do
  .d-flex.justify-content-start.align-items-center.gap-3.pe-5.pb-1
    %h2.admin-h2.fw-bold.mt-3 Journey to Registration Events

  .admin-table-container
    %table.admin-table.interests
      %thead
        %tr
          %th Name
          %th Email
          %th Actions
      %tbody
        - @admin_interests.each do |interest|
          %tr
            %td= interest.name
            %td= interest.email
            %td
              = link_to 'Show', admin_interest_path(interest, page: @page), class: 'btn btn-primary btn-sm', data: { turbo_frame: 'modal' }
              = link_to 'Destroy', admin_interest_path(interest, page: @page), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger ms-1 btn-sm'

  .pagination
    = render 'admin/pagination_table', base_params: { controller: 'admin/interests', action: 'index', page: @page }, page_param: :page, table_name: 'interests_table', label: 'Interests', current_page: @page, total_pages: @total_pages

= turbo_frame_tag 'modal'