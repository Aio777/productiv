-# frozen_string_literal: true
= simple_form_for [:admin, admin_post], data: (turbo_frame_request? ? {} : { turbo: false }), html: { onsubmit: "alert('Post saved!')" } do |f|
  = hidden_field_tag :page, [(params[:page] || @page).to_i, 1].max
  = hidden_field_tag :sort, params[:sort].presence || @sort
  .card-body
    .mb-3
      %h4.form-static-text Original FAQ
      %p
        %strong.form-static-text Title: 
        = @admin_post.title
      %p
        %strong.form-static-text Content: 
        = @admin_post.body

    %hr.section-divider.my-4.border-0.mx-auto

    %h4.form-static-text Admin Response
    = f.hidden_field :answer_by_admin, value: true
    = f.hidden_field :parent_id, value: @admin_post.id
    = f.input :hidden, as: :boolean, wrapper_html: { class: 'mb-3' }, label: 'Hide from public view', input_html: { class: 'form-control-checkbox' }
    = f.input :title, wrapper_html: { class: 'mb-3' }
    = f.input :body, label: 'Admin Response', wrapper_html: { class: 'mb-3' }

  .card-footer.d-flex.align-items-center.justify-content-center
    %button.btn.btn-primary{ type: 'submit' }
      Save