.row.justify-content-center
  .col-sm-8.col-lg-6
    .card
      .card-header
        FAQs
      .card-body
        %dl.row.mb-0
          %dt.col-md-3 Title:
          %dd.col-md-9= @admin_post.title
          %dt.col-md-3 Body:
          %dd.col-md-9= @admin_post.body
      .card-footer.d-flex
        = link_to 'Edit', edit_admin_post_path(@admin_post), class: 'btn btn-link'
        = link_to 'Back', admin_posts_path, class: 'btn btn-link ms-auto'