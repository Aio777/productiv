        = hidden_field_tag :index, 2

    .review-content
      .border-start.ps-3
        - if @review_index_two
          %p.mb-1.fs-5.fw-bold= "#{@review_index_two.name} wrote:"
          %p.text-muted.fs-5.mb-0= @review_index_two.body
        - else
          %p.text-muted No review selected

  .admin-card.admin-displayed-review-card
    .choose-review
      %label.mb-2 Third Review Shown
      = form_with url: admin_update_review_path(page: params[:page], sort: @sort), method: :post, local: true do
        %select.form-select{ name: 'review_id', onchange: 'this.form.submit()' }
