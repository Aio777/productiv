= turbo_frame_tag 'task_detail' do
  .task-editor
    .task-editor-header
      - editable = team_project.team_lead == current_user
      - is_assigned = task.assigned_members.any?
      - assigned_to_current_member = current_member.present? && task.assigned_member_ids.include?(current_member.id)
      - completable_task = editable || assigned_to_current_member
      %h1 Task Details
      - if completable_task && is_assigned
        = button_to 'Complete Task',
          subscriber_complete_shared_task_path(task),
          method: :patch,
          data: { turbo_confirm: 'Is this task complete?', turbo_frame: '_top' },
          class: 'btn btn-success'

    = form_with model: task,
      url: subscriber_shared_task_path(task),
      data: { turbo_frame: '_top' } do |f|

      .task-detail-layout{
        data: {
          controller: 'ai-task-breakdown',
          ai_task_breakdown_endpoint_value: subscriber_ai_taskbreakdown_generate_path,
            ai_task_breakdown_fallback_endpoint_value: subscriber_ai_taskbreakdown_fallback_path
        }
      }
        .task-detail-main
          = f.hidden_field :team_project_id, value: team_project.id

          .field
            .task-name-header.mb-4
              = f.label :name, 'Task name'
              - if completable_task
                = button_tag type: 'button',
                  id: 'ai-button',
                  class: 'ai-button',
                  data: { action: 'click->ai-task-breakdown#open' } do
                  = image_pack_tag 'images/ai_icon.png', alt: 'AI'
                  %span AI Task Breakdown
            = f.text_field :name, class: 'task-input', disabled: !editable, required: true, data: { ai_task_breakdown_target: 'name', user_id: current_user.id, task_type: :shared }

          .field.task-description-field
            = f.label :description
            = f.text_area :description, rows: 5, class: 'task-input', disabled: !editable, required: true, data: { ai_task_breakdown_target: 'description' }

          .assignment-panel.assignment-panel--mobile
            .assignment-panel__header
              %h2 Assign Team Members

            .assignment-list
              - project_members.each do |member|
                - user = member.user
                - next unless user
                - checked = task.assigned_members.exists?(member.id)
                - display_name = [user.first_name, user.last_name].join(' ').strip.presence || user.email

                - if !editable && checked
                  %label.assignment-row{ for: "task_#{task.id}_user_#{member.id}" }
                    .assignment-row__name
                      = display_name
                    .assignment-row__control
                      = check_box_tag 'member_ids[]', member.id, checked, id: "task_#{task.id}_user_#{member.id}", disabled: !editable

                - elsif editable
                  %label.assignment-row{ for: "task_#{task.id}_user_#{member.id}" }
                    .assignment-row__name
                      = display_name
                    .assignment-row__control
                      = check_box_tag 'member_ids[]', member.id, checked, id: "task_#{task.id}_user_#{member.id}", disabled: !editable

          .field-row
            .field
              = f.label :due_date
              = f.date_field :due_date, class: 'task-input', disabled: !editable, required: true

            .field{ data: { controller: editable ? 'reminder-toggle' : nil } }
              .reminder-header
                = f.label :reminder_date
                - if editable
                  = check_box_tag 'reminder_enabled',
                    '1',
                    task.reminder_date.present?,
                    data: { action: 'reminder-toggle#toggle' },
                    class: 'reminder-checkbox'

              = f.date_field :reminder_date,
                class: "task-input #{'reminder-disabled' if task.reminder_date.blank?}",
                data: (editable ? { reminder_toggle_target: 'input' } : {}),
                disabled: !editable || task.reminder_date.blank?

          .field-row
            .field
              = f.label :difficulty
              = f.select :difficulty,
                [%w[Easy easy], %w[Medium medium], %w[Hard hard]],
                { prompt: 'Select difficulty' },
                class: 'task-input',
                disabled: !editable

            .field
              = f.label :points
              = f.text_field :points, class: 'task-input', disabled: true

          - if editable
            .actions
              = f.submit 'Save Task', class: 'btn btn-primary'
              = link_to 'Delete Task', subscriber_shared_task_path(task), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this task?', turbo_frame: '_top' }, class: 'btn btn-danger'

        .task-detail-sidebar
          .assignment-panel.assignment-panel--desktop
            .assignment-panel__header
              %h3 Assign Team Members

            .assignment-list
              - project_members.each do |member|
                - user = member.user
                - next unless user
                - checked = task.assigned_members.exists?(member.id)
                - display_name = [user.first_name, user.last_name].join(' ').strip.presence || user.email

                - if !editable && checked
                  %label.assignment-row{ for: "desktop_task_#{task.id}_user_#{member.id}" }
                    .assignment-row__name
                      = display_name
                    .assignment-row__control
                      = check_box_tag 'member_ids[]', member.id, checked, id: "desktop_task_#{task.id}_user_#{member.id}", disabled: !editable

                - elsif editable
                  %label.assignment-row{ for: "desktop_task_#{task.id}_user_#{member.id}" }
                    .assignment-row__name
                      = display_name
                    .assignment-row__control
                      = check_box_tag 'member_ids[]', member.id, checked, id: "desktop_task_#{task.id}_user_#{member.id}", disabled: !editable

        .modal.fade.ai-breakdown-modal{ tabindex: '-1', 'aria-hidden' => 'true' }
          .modal-dialog.modal-dialog-centered
            .modal-content
              .modal-header
                %h4.modal-title AI Task Breakdown
                %button#btn-close.btn-close{ type: 'button', data: { bs_dismiss: 'modal' }, 'aria-label' => 'Close' }
              .modal-body
                %div{ data: { ai_task_breakdown_target: 'content' } }
              - if editable
                .modal-footer
                  = button_tag 'Add to task description', type: 'button', class: 'btn btn-primary', data: { ai_task_breakdown_target: 'saveButton', action: 'click->ai-task-breakdown#addToTaskDescription' }