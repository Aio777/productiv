= turbo_frame_tag 'task_detail' do
  .task-editor
    .task-editor-header
      %h1 Task Details

    .task-detail-layout
      .task-detail-main{ 
        data: { 
          controller: 'ai-task-breakdown',
          ai_task_breakdown_endpoint_value: subscriber_ai_taskbreakdown_generate_path,
          ai_task_breakdown_fallback_endpoint_value: subscriber_ai_taskbreakdown_fallback_path
        } 
      }
        = form_with model: [:subscriber, task],
          url: subscriber_individual_tasks_path,
          method: :post,
          data: { turbo_frame: '_top' } do |f|

          .field
            .task-name-header.mb-4
              = f.label :name, 'Task name'
              = button_tag type: 'button',
                class: 'ai-button',
                data: { action: 'click->ai-task-breakdown#open' } do
                = image_pack_tag 'images/ai_icon.png', alt: 'AI'
                %span AI Task Breakdown
            = f.text_field :name, class: 'task-input', required: true, data: { ai_task_breakdown_target: 'name', user_id: current_user.id, task_type: :individual }

          .field
            = f.label :description
            = f.text_area :description, rows: 5, class: 'task-input', required: true, data: { ai_task_breakdown_target: 'description' }

          .field-row
            .field
              = f.label :due_date
              = f.date_field :due_date, class: 'task-input', required: true

            .field{ data: { controller: 'reminder-toggle' } }
              .reminder-header
                = f.label :reminder_date
                = check_box_tag 'reminder_enabled',
                  '1',
                  task.reminder_date.present?,
                  data: { action: 'reminder-toggle#toggle' },
                  class: 'reminder-checkbox'

              = f.date_field :reminder_date,
                class: "task-input #{'reminder-disabled' if task.reminder_date.blank?}",
                data: { reminder_toggle_target: 'input' },
                disabled: task.reminder_date.blank?

          .field-row
            .field
              = f.label :difficulty
              = f.select :difficulty,
                [["Easy", "easy"], ["Medium", "medium"], ["Hard", "hard"]],
                { prompt: "Select difficulty" },
                class: "task-input", 
                required: true

          .actions
            = f.submit 'Create Task', class: 'btn btn-primary'

        .modal.fade.ai-breakdown-modal{ tabindex: '-1', 'aria-hidden' => 'true' }
          .modal-dialog.modal-dialog-centered
            .modal-content
              .modal-header
                %h2.modal-title AI Task Breakdown
                %button#btn-close.btn-close{ type: 'button', data: { bs_dismiss: 'modal' }, 'aria-label' => 'Close' }
              .modal-body
                %div{ data: { ai_task_breakdown_target: 'content' } }
              .modal-footer
                = button_tag 'Add to task description', type: 'button', class: 'btn btn-primary', data: { ai_task_breakdown_target: 'saveButton', action: 'click->ai-task-breakdown#addToTaskDescription' }