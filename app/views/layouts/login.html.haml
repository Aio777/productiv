!!!
%html{ lang: 'en' }
  %head
    %title Login
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_pack_tag 'styles', "data-turbo-track": 'reload'
    = javascript_pack_tag 'application', "data-turbo-track": 'reload'

  %body.login-container
    = render 'components/navbar'
    #flash_messages.flash-notification-container
      - flash.each do |message_type, message|
        - next unless %w[alert notice].include?(message_type)

        .alert.alert-dismissible.fade.show.flash-notification{
          class: "alert-#{message_type == 'notice' ? 'success' : 'danger'}",
          role: 'alert'
        }
          = message
          %button.btn-close{
            type: 'button',
            data: { bs_dismiss: 'alert' },
            aria: { label: 'Close' }
          }

    = yield
