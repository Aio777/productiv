!!!
%html{ lang: 'en' }
  %head
    %title Admin
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_pack_tag 'styles', media: 'all', "data-turbo-track": 'reload'
    = javascript_include_tag 'https://www.gstatic.com/charts/loader.js'
    = javascript_pack_tag 'application', "data-turbo-track": 'reload'

  %body.admin-body
    = render 'components/navbar'
    .d-flex
      %aside.aside.admin-sidebar.shadow-sm.col-3
        = link_to root_path, class: 'nav-link d-flex justify-content-center mb-3', aria: { label: 'Go to Home page' } do
          = image_pack_tag 'images/productiv_logo_cut.png', height: 70, alt: 'Productiv Logo'

        %nav
          = link_to 'Admin Dashboard', admin_root_path, class: "nav-link block py-2 #{'current-highlight' if current_page?(admin_root_path)}"
          = link_to 'Users', admin_users_path, class: "nav-link block py-2 #{'current-highlight' if controller_path.start_with?('admin/users')}"
          = link_to 'FAQs', admin_posts_path, class: "nav-link block py-2 #{'current-highlight' if controller_path.start_with?('admin/posts')}"
          = link_to 'Reviews', admin_reviews_path, class: "nav-link block py-2 #{'current-highlight' if controller_path.start_with?('admin/reviews')}"
          = link_to 'Interests', admin_interests_path, class: "nav-link block py-2 #{'current-highlight' if controller_path.start_with?('admin/interests')}"

      %main.admin-main-body
        #flash_messages.flash-notification-container
          - flash.each do |message_type, message|
            - next unless %w[alert notice].include?(message_type)

            .alert.alert-dismissible.fade.show.flash-notification{
              class: "alert-#{message_type == 'notice' ? 'success' : 'danger'}",
              role: 'alert'
            }
              = message
              %button.btn-close{
                type: 'button',
                data: { bs_dismiss: 'alert' },
                aria: { label: 'Close' }
              }
        = yield
