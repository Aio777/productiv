!!!
%html{ lang: 'en' }
  %head
    %title Admin
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_pack_tag 'styles', media: 'all', "data-turbo-track": 'reload'

  %body
    %header.error-top-navbar
      = link_to root_path, class: 'nav-link block py-2', aria: { label: 'Go to Home page' } do
        = image_pack_tag 'images/productiv_logo_cut.png', height: 70, alt: 'Productiv Logo'
      %button.navbar-toggler{ type: :button, data: { bs_toggle: :collapse, bs_target: '#navbar-content' }, aria: { controls: 'navbar-content', expanded: 'false', label: 'Toggle navigation' } }
        %span.navbar-toggler-icon

    %main.error-main
      = yield