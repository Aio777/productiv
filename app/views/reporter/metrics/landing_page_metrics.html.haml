.container.py-4
  %h1.page-title.mb-4 Landing Page Metrics
  .row.g-4
    = render('components/chart/chart',
    chart_title: @landing_page_metrics[:bounce_rate][:title],
    chart_label: @landing_page_metrics[:bounce_rate][:label],
    chart_data: @landing_page_metrics[:bounce_rate][:value],
    is_continuous: @landing_page_metrics[:bounce_rate][:continuous],
    chart_time_unit: @landing_page_metrics[:bounce_rate][:time_unit])

