.container.py-4
  %h1.page-title.mb-4 Feature Engagement Metrics
  .row.g-4
    = render('components/chart/chart',
    chart_title: @feature_engagement_metrics[:pomodoro_sessions][:title],
    chart_label: @feature_engagement_metrics[:pomodoro_sessions][:label],
    chart_data: @feature_engagement_metrics[:pomodoro_sessions][:values],
    is_continuous: @feature_engagement_metrics[:pomodoro_sessions][:continuous],
    chart_time_unit: @feature_engagement_metrics[:pomodoro_sessions][:time_unit])

