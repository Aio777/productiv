.container.py-4
  = turbo_frame_tag 'reporter_charts' do
    .card.custom-top-bar-bg.mb-4.px-4.py-3
      .container-fluid
        .d-flex.flex-column.flex-md-row.align-items-center.justify-content-center.justify-content-md-between.gap-2
          
          .text-center.order-1.order-md-2
            %h2.h4.m-0 
              Reporter Dashboard

          .d-flex.justify-content-center.justify-content-md-end.order-3.order-md-3
            .dropdown.graph-toggle-dropdown{ data: { bs_auto_close: 'outside' } }
              = button_tag class: 'btn btn-primary text-white dropdown-toggle',
                type: 'button',
                data: { bs_toggle: 'dropdown' },
                aria: { expanded: false } do
                %i.bi.bi-graph-up
                Toggle Graphs

              .dropdown-menu.p-3{ onclick: 'event.stopPropagation()' }
                = form_with url: reporter_kpi_path(current_user), scope: :user, method: :patch do |form|

                  .form-check
                    = form.checkbox :landing_page_visits_time_toggled, checked: @display_values[0], class: 'form-check-input'
                    = form.label :landing_page_visits_time_toggled, 'Landing Page Visits Over Time + Bounce Rate', class: 'form-check-label'

                  .form-check
                    = form.checkbox :landing_page_registrations_time_toggled, checked: @display_values[1], class: 'form-check-input'
                    = form.label :landing_page_registrations_time_toggled, 'Landing Page Registrations Over Time', class: 'form-check-label'

                  .form-check
                    = form.checkbox :landing_page_traffic_sources_toggled, checked: @display_values[2], class: 'form-check-input'
                    = form.label :landing_page_traffic_sources_toggled, 'Landing Page Traffic Sources', class: 'form-check-label'

                  .form-check
                    = form.checkbox :active_users_over_time_toggled, checked: @display_values[3], class: 'form-check-input'
                    = form.label :active_users_over_time_toggled, 'Active Users Over Time', class: 'form-check-label'

                  .mt-2.d-flex.justify-content-center
                    = form.submit 'Apply', class: 'btn btn-primary'

    .row.g-4
      - @dashboard_data.each do |chart_data|
        = render('components/chart/chart',
        chart_title: chart_data[:title],
        chart_label: chart_data[:label],
        chart_data: chart_data[:values],
        is_continuous: chart_data[:continuous],
        chart_time_unit: chart_data[:time_unit])
