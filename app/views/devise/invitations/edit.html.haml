.container.d-flex.justify-content-center.signup-page
  .card.shadow-lg.p-4.signup-card
    %h2.text-center.mb-4
      = t('devise.invitations.edit.header')

    = simple_form_for(resource, as: resource_name, url: invitation_path(resource_name), html: { method: :put }) do |f|
      = f.error_notification
      = f.hidden_field :invitation_token

      .mb-3
        = f.label :password, 'New password', class: 'form-label'
        = f.input_field :password,
                        required: true,
                        autofocus: true,
                        autocomplete: 'new-password',
                        class: 'form-control'

      .mb-3
        = f.label :password_confirmation, 'Confirm your new password', class: 'form-label'
        = f.input_field :password_confirmation,
                        required: true,
                        autocomplete: 'new-password',
                        class: 'form-control'

      .d-grid
        = f.button :submit, t('devise.invitations.edit.submit_button'), class: 'btn btn-primary'