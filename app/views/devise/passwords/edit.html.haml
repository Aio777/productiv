.container.d-flex.justify-content-center.signup-page.long-page
  .card.shadow-lg.p-4.signup-card
    %h2.text-center.mb-4 Change your password

    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
      = f.error_notification

      = f.input :reset_password_token, as: :hidden
      = f.full_error :reset_password_token

      .mb-3
        = f.label :password, 'New password', class: 'form-label'
        = f.input_field :password,
                        required: true,
                        autofocus: true,
                        autocomplete: 'new-password',
                        class: 'form-control'

        - if @minimum_password_length
          %small.text-muted
            = "#{@minimum_password_length} characters minimum"

      .mb-3
        = f.label :password_confirmation, 'Confirm your new password', class: 'form-label'
        = f.input_field :password_confirmation,
                        required: true,
                        autocomplete: 'new-password',
                        class: 'form-control'

      .d-grid
        = f.button :submit, 'Change Password', class: 'btn btn-primary'
