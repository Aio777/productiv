/ Feature cards
%div.feature-card-container 
  .row.feature-cards.justify-content-center
    = render('components/feature_card', 
      icon_class: 'bi bi-magic', 
      title: 'Task Breakdown Assistance with AI', 
      description: 'Deconstruct complex projects into actionable tasks with AI integration',
      bs_target: '#featuresModal',
      bs_message: "Not knowing what needs to be done for a large or complicated task can quickly become overwhelming and demoralising, leading to increased stress and procrastination. With AI integration, tasks can be efficiently broken down into smaller, manageable sub-tasks and prioritised for you, providing clarity and ensuring you know what needs to be done.",
      bs_image: image_pack_tag("images/AI_Task_Break_Down_Tool.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_TASK_BREAKDOWN_AI_FEATURE])
    = render('components/feature_card', 
      icon_class: 'bi bi-layout-text-window-reverse', 
      title: 'Workspaces & Projects', 
      description: 'Organise your work across multiple workspaces and projects',
      bs_target: "#featuresModal",
      bs_message: "Organise your responsibilities and collaborate with your peers using one centralised tool that can be accessed anywhere. Workspaces can be dedicated to a specific subject or team projects, with visibility options available to balance teamwork with independence while guaranteeing everyone knows what is happening.",
      bs_image: image_pack_tag("images/Workspaces_Projects.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_WORKSPACES_AND_PROJECTS_FEATURE])
    = render('components/feature_card', 
      icon_class: 'bi bi-graph-up-arrow', 
      title: 'Progress Visualisation', 
      description: 'Track progress with key performance indicators',
      bs_target: "#featuresModal",
      bs_message: "Understanding how much progress has been made towards a goal can be difficult, especially if it doesn't feel like you're any closer to finishing. Being able to visualise your productivity through intuitive charts and progress bars provides information about project progress, increases motivation and allows you to maintain momentum.",
      bs_image: image_pack_tag("images/KPI_Graph_1.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_PROGRESS_VISUALISATION_FEATURE])
    = render('components/feature_card', 
      icon_class: 'bi bi-stopwatch', 
      title: 'Pomodoro Timer', 
      description: 'Enhance productivity by working in focused intervals',
      bs_target: '#featuresModal',
      bs_message: "Reduce unhelpful distractions and maintain uninterrupted focus by dedicating a realistic length of time for work and prevent fatigue by taking timed breaks. This allows you to instantly continue where you left off without needing to rethink what you were doing, boosting productivity and efficiency.",
      bs_image: image_pack_tag("images/Pomodoro_Timer.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_POMODORO_TIMER_FEATURE])

  .row.feature-cards.justify-content-center
    = render('components/feature_card', 
      icon_class: 'bi bi-stars', 
      title: 'Be Rewarded for Progress', 
      description: 'Earn points for completing tasks, with more difficult tasks being more rewarding',
      bs_target: '#featuresModal',
      bs_message: "Feel accomplished when you complete a task, no matter the size, by earning points. The amount of points awarded scales with the difficulty of the task, providing motivation to complete high rewarding tasks and encouragement to work on the hardest of days.",
      bs_image: image_pack_tag("images/Be_Rewarded_for_Progress.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_PROGRESS_REWARDED_FEATURE])
    = render('components/feature_card', 
      icon_class: 'bi bi-award', 
      title: 'Leaderboards', 
      description: 'Compete with friends and teammates on designated leaderboards',
      bs_target: '#featuresModal',
      bs_message: "Challenge your friends or teammates to achieve the highest number of points over a span of time, boosting motivation through competition and providing a sense of accountability to complete tasks. If this is not for you, you will have the option to keep your progress private.",
      bs_image: image_pack_tag("images/Friends_Leaderboard.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_LEADERBOARDS_FEATURE])
    = render('components/feature_card', 
      icon_class: 'bi bi-leaf', 
      title: 'Your Virtual Plant', 
      description: 'Grow and customise your own plant using your hard earned points',
      bs_target: '#featuresModal',
      bs_message: "A fun, engaging and interactive representation of the work you have accomplished, your plant can be grown by watering it every day using the points you earn, encouraging daily engagement. But be careful - running out of points means you won't be able to water your plant and it will start wilting. For the plant to best represent you, you can customise it using points and share your creative changes with friends, fostering pride and satisfaction while motivating you to complete tasks.",
      bs_image: image_pack_tag("images/Plant_Image_1.png", class: "feature-card-modal-img"),
      bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_VIRTUAL_PLANT_FEATURE])

= render 'components/features_modal'

