%div.content-card
  %h2.text-xl.font-semibold.mb-4 User Reviews
  .rounded.divide-y
    - @reviews.each do |review|
      = turbo_frame_tag dom_id(review) do
        %li.p-4.shadow
          %div.flex.justify-between.items-center
            %strong= review.name
            %div.text-yellow-500
              - review.rating.times do
                ★

          %p.mt-2= review.body

          - voted = session[:review_vote]&.[](review.id.to_s)

          .mt-3.d-flex.gap-4.flex-row{ data: { controller: 'home' } }
            = button_to '👍', upvote_review_path(review),
              method: :post,
              class: "px-3 py-1 rounded thumb-button-good #{'opacity-50 cursor-not-allowed' if voted}",
              disabled: voted.present?

            = button_to '👎', downvote_review_path(review),
              method: :post,
              class: "px-3 py-1 rounded thumb-button-bad #{'opacity-50 cursor-not-allowed' if voted}",
              disabled: voted.present?
  .text-center.mt-4
    %button.btn.btn-lg{
      type: 'button',
      data: {
        bs_toggle: 'modal',
        bs_target: '#newReviewModal',
        bs_event_view_name: Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:OPENED_LEAVE_REVIEW_MODAL]
      }
    } Leave a Review

= render 'components/new_review_modal'

%div.content-card
  %h2.text-xl.font-semibold.mb-4 Recent FAQs
  %div.accordion{ id: 'faqAccordion' }
    - @posts.each do |post|
      %div.accordion-item
        %div.accordion-header{ id: "headingPost#{post.id}" }
          %button.accordion-button.collapsed.flex-column{
            type: 'button',
            data: {
              testid: "faq-button-#{post.id}",
              bs_toggle: 'collapse',
              bs_target: "#collapsePost#{post.id}",
              bs_event_view_name: "#{Metrics::LandingPageMetrics::AHOY_EVENT_NAMES[:VIEWED_QUESTION_PREFIX]} '#{post.title}'"
              },
            aria: { expanded: 'false', controls: "collapsePost#{post.id}" }
            }
            %span.fw-bold= post.title
            %span.text-muted= post.body
        %div.accordion-collapse.collapse{ id: "collapsePost#{post.id}", data: { bs_parent: '#faqAccordion' } }
          .accordion-body
            - post.replies.order(answer_by_admin: :desc, created_at: :desc).each do |reply|
              .p-2.rounded-bottom
                %strong= reply.title
                %div= reply.body

%div.content-card   
  %h2.text-xl.font-semibold.mb-4 Post a Question

  = form_with model: @new_post, url: posts_path, local: true, html: { onsubmit: "alert('Post saved!')" } do |f|
    .mb-4.d-flex.flex-column.gap-3
      = f.text_area :title, rows: 1, class: 'mt-1 block w-full border rounded p-2', placeholder: 'Title'
      = f.text_area :body, rows: 3, class: 'mt-1 block w-full border rounded p-2', placeholder: 'Body'
    = f.submit 'Post', class: 'btn px-4 py-2 rounded'

%div.content-card
  %h2.text-lg.font-semibold Share This Page
  = render 'components/share_buttons'
