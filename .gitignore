# Environment / secrets
/.env
/.env.*
!/.env.example
/config/credentials/*.key
/config/credentials/*.yml.enc
/config/master.key
/config/database.yml
/config/deploy/*-local.rb

# Rails logs / tmp / storage
/log/*
/tmp/*
/storage/*
!log/.keep
!tmp/.keep

# Generated / tooling output
/coverage/
/brakeman/
/brakeman.html
/.bundle/
/.ruby-lsp/
/.DS_Store

# JS / asset build
/node_modules/
/vendor/bundle/
/public/packs/
/public/assets/
/.yarn/releases/

# Data dumps
*.sqlite3
*.dump
